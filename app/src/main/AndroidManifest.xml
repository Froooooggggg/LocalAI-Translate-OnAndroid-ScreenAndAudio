<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 采集其他 App 播放的音频（Android 10+） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 前台服务：MediaProjection 必须在带 mediaProjection 类型的前台服务中运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 用于把 WAV 落到公共 Music 目录，方便直接取出分析（P0 专用，后续可移除） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 后续阶段需要（悬浮窗/后台拉起） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenAudioTranslate"
        tools:targetApi="36">

        <!--
          llama.cpp 的 GPU 后端要用系统 OpenCL。

          ⚠️ 这条**不是可选优化，是能不能启动的问题**：
          `libllama.so` 的 DT_NEEDED 里硬列了 `libggml-opencl.so`，而后者又硬依赖
          `libOpenCL.so`。动态链接器解析不到它 → `System.loadLibrary("llama_jni")`
          直接抛 UnsatisfiedLinkError，整个 JNI 层用不了（哪怕我们只想用 CPU 或 NPU）。

          而 `libOpenCL.so` 在 /vendor/lib64 下、列在 /vendor/etc/public.libraries.txt 里，
          属于**厂商公共库（VPL）**——从 Android 10 起，VPL 必须在 manifest 里用
          `<uses-native-library>` 显式声明才会被加进应用的 linker namespace。
          不声明就会报 `library "libOpenCL.so" not found ... in namespace clns-NN`，
          看着像设备没这个库，其实是没申请访问权。

          真机实测（SM8750 / Android 16）：`/vendor/lib64/libOpenCL.so` 存在（95800 B），
          `/vendor/etc/public.libraries.txt` 里也确实有 `libOpenCL.so`。

          ⚠️ 位置：`<uses-native-library>` 是 **`<application>` 的子元素**，放 <manifest>
             下面会被 AAPT 拒掉（`unexpected element <uses-native-library> found in <manifest>`）。

          `required="false"`：没有 OpenCL 的设备只是少一个 GPU 后端，不该因此装不上。
          代价是加载时会打一行 "OpenCL backend not available"，属正常。
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <!--
          llama.cpp 的 Hexagon NPU 后端要用 vendor 的 fastrpc 驱动。

          和上面 libOpenCL.so 是**同一个坑**，我第一版漏了：hexagon 后端自己的日志是
              ggml-hex: Loading driver libcdsprpc.so
              ggml-hex: failed to load libcdsprpc.so: dlopen failed: library "libcdsprpc.so" not found
          然后整个后端静默不注册 —— 界面上只表现为「设备列表里只有 GPUOpenCL 和 CPU」，
          完全看不出是权限问题。

          ⚠️ 这个后端值得修：真机实测同一模型同一台手机，
              prefill  CPU 165 tok/s  →  NPU 2018 tok/s（**12 倍**）
              decode   CPU 30.8 tok/s →  NPU 36.2 tok/s
          首字延迟是这条路唯一的短板，而它正是被 prefill 决定的。

          `required="false"`：非骁龙的机器没有这个库，不该因此装不上。
        -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <!--
          **唯一的桌面入口**：实时同传（内含「同传 / 识图」两页，底部菜单栏切换）。

          历史上的 4 个控制台（P0 主界面、NLLB 调试台、听写调试台、2B 翻译调试台）
          已全部删除：它们的作用都被这个界面吸收了（识别/翻译/上下文/网络API/浮窗都在设置页里），
          桌面上只留一个图标。要抓完整日志仍然走 `adb logcat`，不需要再开界面。
        -->
        <activity
            android:name=".InterpretActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 识图抓屏（⑬-V2）：同一个 MediaProjection 只能建一个 VirtualDisplay，
             所以它和上面的音频采集**互斥**，谁先起谁占，另一路必须先停。 -->
        <service
            android:name=".vision.VisionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 无障碍：悬浮窗显示 + 字幕文字兜底采集 -->
        <service
            android:name=".overlay.TranslateAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
